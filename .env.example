# Server-side Vercel environment variables. Never put these in frontend code.
# Generate TWO independent values of at least 32 random bytes; do not use these placeholders.
HAX_MOCK_JWT_SECRET=
HAX_MOCK_REAUTH_SECRET=

# Connect Upstash for Redis through Vercel Storage. The integration's KV_REST_API_URL
# and KV_REST_API_TOKEN are also supported instead of these names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Production and preview use separate defaults. Keep this stable across deployments.
# HAX_MOCK_STORAGE_PREFIX=haxcms-settings-panel:production
